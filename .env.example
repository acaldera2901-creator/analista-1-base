# === ANTHROPIC API ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === TELEGRAM BOT ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal Telegram chat ID (run /start with the bot to get it)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# === ANALYST SETTINGS ===
# Timezone for scheduling (e.g. Europe/Rome, America/New_York)
ANALYST_TIMEZONE=Europe/Rome
# Daily briefing time (24h format)
MORNING_BRIEFING_TIME=07:30
# How often to check for breaking news (minutes)
ALERT_CHECK_INTERVAL=15

# === INSTRUMENTS TO MONITOR ===
# Comma-separated list
INSTRUMENTS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCHF,USDCAD,NZDUSD,XAUUSD,BTCUSD

# === RISK SENSITIVITY ===
# Minimum impact level to trigger proactive alert (low/medium/high/critical)
MIN_ALERT_IMPACT=high

# === MEMORY & STORAGE ===
DATA_DIR=./data
ANALYSES_DIR=./data/analyses
MARKET_DATA_DIR=./data/market_data
MEMORY_DIR=./data/memory
PERFORMANCE_DIR=./data/performance
LOGS_DIR=./logs
